# Copiez ce fichier en .env.local pour tester en local avec `vercel dev`.
# En production, ces variables se renseignent dans Vercel > Project Settings
# > Environment Variables (voir README.md).

# Le même projet Supabase que l'application mobile (ADM-APP). Trouvables
# dans supabase.com/dashboard > votre projet > Project Settings > API Keys.
SUPABASE_URL=

# Clé "publishable" (anciennement "anon") — c'est la clé PUBLIQUE, sans
# risque à utiliser ici : elle ne permet que ce que les policies RLS
# autorisent explicitement (voir README.md — on n'autorise que l'écriture
# dans la table adm_site_leads, pas la lecture).
SUPABASE_ANON_KEY=

# Clé "secret" (anciennement "service_role") — celle-ci contourne les
# policies RLS, donc permet de tout lire/écrire. Utilisée par api/leads.js
# ET par lib/adminAuth.js (comptes admin) — jamais côté navigateur. Ne
# JAMAIS la mettre dans du code ou un fichier commité.
SUPABASE_SECRET_KEY=

# Resend (resend.com) — envoie la notification à adm.appcontacts@gmail.com.
# Aucune connexion à un compte Gmail nécessaire : juste une clé API.
RESEND_API_KEY=

# Pas de mot de passe admin unique ici : les comptes admin (email + mot de
# passe, hashé avec bcrypt) sont créés directement depuis la page
# /admin-x7f2k9.html ("Créer un compte"), stockés dans la table Supabase
# admin_users. Rien à configurer en variable d'environnement pour ça.
