# Copiez ce fichier en .env.local pour tester en local avec `vercel dev`.
# En production, ces variables se renseignent dans Vercel > Project Settings
# > Environment Variables (voir README.md).

# Injectées automatiquement par Vercel quand vous connectez une base
# Upstash (Redis) au projet (Storage > Create Database > Upstash) — ne
# pas remplir à la main en production, seulement utile ici pour du test
# local avancé.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# EmailJS (emailjs.com) — sert à envoyer la notification à
# adm.appcontacts@gmail.com sans mot de passe d'application Gmail.
# Voir README.md pour la marche à suivre (créer un compte, connecter Gmail
# en un clic, créer un template).
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# Mot de passe pour accéder à la page /admin-x7f2k9.html — choisissez une
# valeur forte, différente de vos autres mots de passe.
ADMIN_PASSWORD=
