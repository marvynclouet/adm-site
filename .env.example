# Copiez ce fichier en .env.local pour tester en local avec `vercel dev`.
# En production, ces variables se renseignent dans Vercel > Project Settings
# > Environment Variables (voir README.md).

# Injectées automatiquement par Vercel quand vous connectez une base
# Upstash (Redis) au projet (Storage > Create Database > Upstash) — ne
# pas remplir à la main en production, seulement utile ici pour du test
# local avancé.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Compte Gmail utilisé pour envoyer les notifications (peut être
# adm.appcontacts@gmail.com lui-même, qui s'enverrait l'email à lui-même).
GMAIL_USER=
# Mot de passe d'application à 16 caractères (PAS le mot de passe normal du
# compte) — généré depuis myaccount.google.com/apppasswords, nécessite la
# validation en 2 étapes activée sur le compte.
GMAIL_APP_PASSWORD=

# Mot de passe pour accéder à la page /admin-x7f2k9.html — choisissez une
# valeur forte, différente du mot de passe Gmail.
ADMIN_PASSWORD=
