# Copiez ce fichier en .env.local pour tester en local avec `vercel dev`.
# En production, ces variables se renseignent dans Vercel > Project Settings
# > Environment Variables (voir README.md).

# Le même projet Supabase que l'application mobile (ADM-APP). Trouvables
# dans supabase.com/dashboard > votre projet > Project Settings > API.
SUPABASE_URL=
# ⚠️ La "service_role" key, PAS la clé "anon" publique : elle permet
# d'écrire dans la table sans passer par une authentification utilisateur.
# Ne jamais l'exposer côté navigateur — elle ne vit que dans ces fonctions
# serverless, jamais dans le HTML/JS du site.
SUPABASE_SERVICE_ROLE_KEY=

# EmailJS (emailjs.com) — envoie la notification à adm.appcontacts@gmail.com.
# Le compte connecté dans EmailJS (l'expéditeur) peut être N'IMPORTE QUEL
# Gmail auquel vous avez accès — pas forcément adm.appcontacts@gmail.com,
# qui n'est que le destinataire (pas besoin de s'y connecter).
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# Mot de passe pour accéder à la page /admin-x7f2k9.html — choisissez une
# valeur forte, différente de vos autres mots de passe.
ADMIN_PASSWORD=
